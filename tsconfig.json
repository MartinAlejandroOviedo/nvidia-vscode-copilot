{
	"compilerOptions": {
		"target": "ES2022",
		"module": "Node16",
		"lib": ["ES2022", "DOM"],
		"strict": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"moduleResolution": "Node16",
		"outDir": "./dist",
		"rootDir": "./src",
		"resolveJsonModule": true,
		"declaration": true,
		"types": ["node"]
	},
	"include": ["src"],
	"exclude": ["node_modules", "dist"]
}